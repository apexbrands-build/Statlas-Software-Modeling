# Copy to .env.local for local development. On Vercel set the same names under Project Settings -> Environment Variables.
# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3111
# "seed" = fictional demo data, "supabase" = real data from the database
NEXT_PUBLIC_DATA_MODE=seed

# Server only. NEVER prefix with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=          # openssl rand -base64 32
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
